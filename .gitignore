hw/*.mf

# But keep example PDFs
!examples/*.pdf
!docs/*.pdf

# Reference card per-page PNG renders (generated by `make reference`)
docs/_pages/

# Temporary files
*.tmp
*.temp
.tmp/
.DS_Store

# Test outputs
test_outputs/
*.test.tex
*.test.pdf

# Coverage
.coverage
htmlcov/
.pytest_cache/

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# Machine-local files (the `local` convention): never committed, at any depth.
# Covers .envrc.local, .claude/settings.local.json, vox.local.md,
# biff config.local.yaml, ethos <ns>.local.yaml extension secrets.
*.local
*.local.*

# punt-labs canonical block (punt-kit standards/punt-labs-dir.md §6):
# the .punt-labs/local/ zone holds ethos live audit/mission writes.
.punt-labs/**/local
.punt-labs/**/local/**
.punt-labs/**/*.local
.punt-labs/**/*.local.*

# ethos runtime locks (never tracked; see ethos docs/audit-seal.md):
# per-mission .lock, missions.jsonl.lock, identities/<handle>.yaml.lock
.punt-labs/ethos/**/*.lock
**/.create.lock

# Homework - private (instructor-provided content, personal coursework)
hw/
hw[0-9]*/

# Tutorial project
rpn2tex/

# user-specific assignments; not for upstream
sem/

# Test-phase artefacts that must not re-enter the tree.
# phase_a_* and phase12_* were transient PDFs from the Phase 1 test run;
# *.disabled marks input files that were disabled pending parser fixes.
examples/*/phase_a_*.pdf
examples/*/phase12_*.pdf
*.disabled

/.punt-labs/quarry/captures/

# Stray root-level cheatsheet from prior workflow (now consolidated into docs/reference.pdf)
/cheatsheet.pdf
/B-summary.pdf
/dat_requirements.md
/docs/txt2tex-reference.pdf
