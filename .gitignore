# Machine-local files (the `local` convention): never committed, at any depth.
# Covers .envrc.local, .claude/settings.local.json, .punt-labs/vox/vox.local.md,
# biff config.local.yaml and ethos <ns>.local.yaml extension secrets.
*.local
*.local.*

# punt-labs machine-local zone and ethos runtime locks
.punt-labs/**/local
.punt-labs/**/local/**
.punt-labs/ethos/**/*.lock
**/.create.lock

# Tutorial project
rpn2tex/

# Private working directories and hand-off notes (never published;
# tests/test_repo_hygiene.py enforces this)
/hw/
/hw[0-9]*/
/sem/
/dat_requirements.md
/resume.md
/.github/ISSUES_TO_CREATE.md
/docs/development/judge-prompt.md
/docs/development/verification-procedure.md

# Environment files hold machine-local settings and secrets
.env
.env.*
!.env.example

# ethos: session logs, mission records and the machine-local zone hold
# private transcripts and machine paths; agent definitions stay committed
/.punt-labs/ethos/sessions/
/.punt-labs/ethos/missions/
/.punt-labs/ethos/missions.jsonl
/.punt-labs/local/

# Test-phase artefacts that must not re-enter the tree.
# phase_a_* and phase12_* were transient PDFs from the Phase 1 test run;
# *.disabled marks input files that were disabled pending parser fixes.
examples/*/phase_a_*.pdf
examples/*/phase12_*.pdf
*.disabled

/.punt-labs/quarry/captures/

# Stray root-level cheatsheet from prior workflow (now consolidated into docs/reference.pdf)
/cheatsheet.pdf
/B-summary.pdf
/docs/txt2tex-reference.pdf
